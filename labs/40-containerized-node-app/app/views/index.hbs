<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
  <style>
  body {
  max-width: 640px;
  margin: 2rem auto;
  padding: 0 1rem;
  font-family: system-ui, -apple-system, sans-serif;
  line-height: 1.5;
  background: rgb(27, 27, 27);
  color: brown;
  }

  h1 {
    margin-bottom: 1.5rem;
    color: chartreuse;
  }

  form {
    margin-bottom: 2rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  button {
    padding: 0.5rem 1rem;
    cursor: pointer;
  }

  .quote {
    margin-bottom: 1rem;
    padding-left: 1rem;
    border-left: 3px solid #ccc;
  }

  .quote-author {
    color: #ffd901;
    font-size: 0.9rem;
  }
  </style>
</head>

<body>
  <h1>QuoteBoard</h1>

  <form method="post" action="/quotes">
    <input name="author" placeholder="Author (optional)" />
    <textarea name="text" placeholder="Write a quote..." required></textarea>
    <button type="submit">Add quote</button>
  </form>

  {{#if quotes.length}}
  {{#each quotes}}
  <div class="quote">
    <div>{{this.text}}</div>
    <div class="quote-author">— {{this.author}}</div>
  </div>
  {{/each}}
  {{else}}
  <p>No quotes yet. Add the first one.</p>
  {{/if}}
</body>

</html>